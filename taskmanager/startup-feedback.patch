+void WaylandStartupTasksModel::Private::notifyStillStarting(PlasmaActivation *activation)
+{
+    auto *startup = find(activation);
+    if (!startup || startup->units.isEmpty() || startup->notificationId != 0) {
+        return;
+    }
+    const int seconds = int(stillStartingTimeout.count());
+    const QString body = seconds < 120 ? i18ncp("@info", "It hasn't shown a window after %1 second.", "It hasn't shown a window after %1 seconds.", seconds)
+                                       : i18ncp("@info", "It hasn't shown a window after %1 minute.", "It hasn't shown a window after %1 minutes.", seconds / 60);
+    auto message = QDBusMessage::createMethodCall(s_notifications, s_notificationsPath, s_notifications, QStringLiteral("Notify"));
+    message << startup->name << uint(0) << startup->iconName << i18nc("@title", "%1 is still starting", startup->name)
+            << body
+            << QStringList{QStringLiteral("wait"),
+                           i18nc("@action:button", "Keep Waiting"),
+                           QStringLiteral("stop"),
+                           i18nc("@action:button %1 is an app's name", "Stop %1", startup->name)}
+            << QVariantMap{{QStringLiteral("urgency"), QVariant::fromValue(uchar(1))}} << int(0);
+    auto *watcher = new QDBusPendingCallWatcher(QDBusConnection::sessionBus().asyncCall(message), activation);
+    QObject::connect(watcher, &QDBusPendingCallWatcher::finished, q, [this, activation](QDBusPendingCallWatcher *watcher) {
+        watcher->deleteLater();
+        const QDBusPendingReply<uint> reply = *watcher;
+        if (auto *startup = find(activation); startup && reply.isValid()) {
+            startup->notificationId = reply.value();
+        }
     });
 }
 
+void WaylandStartupTasksModel::Private::notifyDidNotOpen(const Startup &startup, bool anotherRunning)
+{
+    const QString body = anotherRunning
+        ? i18nc("@info %1 is an app's name",
+                "It exited without showing a window. Another %1 is already running, and may not be responding.",
+                startup.name)
+        : i18nc("@info", "It exited without showing a window.");
+    auto message = QDBusMessage::createMethodCall(s_notifications, s_notificationsPath, s_notifications, QStringLiteral("Notify"));
+    message << startup.name << uint(0) << startup.iconName << i18nc("@title %1 is an app's name", "%1 didn't open", startup.name) << body
+            << QStringList{} << QVariantMap{} << int(-1);
+    QDBusConnection::sessionBus().asyncCall(message);
+}
