+// Quine Linux: the launch feedback follows the launched app instead of a
+// fixed timer.
+//
+// KDE starts an app (KIO) in a systemd unit named after it, as systemd's
+// desktop conventions say: app-<id>@<random>.service, and a Flatpak moves it
+// on into app-flatpak-<id>-<pid>.scope. While the feedback is up, this polls
+// systemd for the app's units, and tells the ones that started since the
+// launch (its own) from ones already running (another copy of the app), by
+// when systemd started them: a launcher in another process (KRunner) can
+// start its unit before this hears of the launch. Then:
+//  - a window of the app, by app id or by its pid being in one of those
+//    units, ends it (windowAppeared(), from TasksModel);
+//  - so does the app registering a tray icon (it started in the background);
+//  - KWin saying the startup finished doesn't end it while the units run:
+//    KWin keeps one startup at a time, and ends it when any window opens;
+//  - the units ending without a window ends it with a notification, "<App>
+//    didn't open" (and that another copy is running, if one is: a launch
+//    that hands over to a hung instance looks like this);
+//  - after StillStartingTimeout (klaunchrc [TaskbarButtonSettings], default
+//    180 s) a notification asks: Keep Waiting, or Stop <App>;
+//  - a launch with no unit to follow (not started through systemd) ends
+//    after the usual Timeout, as before.
+namespace
+{
+const QString s_systemd = QStringLiteral("org.freedesktop.systemd1");
+const QString s_systemdPath = QStringLiteral("/org/freedesktop/systemd1");
+const QString s_systemdManager = QStringLiteral("org.freedesktop.systemd1.Manager");
+const QString s_notifications = QStringLiteral("org.freedesktop.Notifications");
+const QString s_notificationsPath = QStringLiteral("/org/freedesktop/Notifications");
+const QString s_sniWatcher = QStringLiteral("org.kde.StatusNotifierWatcher");
+const QString s_sniWatcherPath = QStringLiteral("/StatusNotifierWatcher");
+constexpr std::chrono::seconds s_pollInterval{1};
+// A unit started this long before the launch was heard of is still its own.
+constexpr qint64 s_startSlackUsec = 2'000'000;
+
+// CLOCK_MONOTONIC in µs, systemd's *TimestampMonotonic clock.
+qint64 monotonicUsec()
+{
+    timespec ts{};
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return qint64(ts.tv_sec) * 1'000'000 + ts.tv_nsec / 1'000;
+}
+
+struct UnitInfo {
+    QString name, description, loadState, activeState, subState, following;
+    QDBusObjectPath path;
+    quint32 jobId = 0;
+    QString jobType;
+    QDBusObjectPath jobPath;
+};
+
+const QDBusArgument &operator>>(const QDBusArgument &arg, UnitInfo &unit)
+{
+    arg.beginStructure();
+    arg >> unit.name >> unit.description >> unit.loadState >> unit.activeState >> unit.subState >> unit.following >> unit.path >> unit.jobId >> unit.jobType
+        >> unit.jobPath;
+    arg.endStructure();
+    return arg;
+}
+
+// As KIO escapes an app id into a unit name (KProcessRunner::escapeUnitName).
+QString escapeUnitName(const QString &input)
+{
+    QString res;
+    const QByteArray bytes = input.toUtf8();
+    for (const unsigned char c : bytes) {
+        if ((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == ':' || c == '_' || c == '.') {
+            res += QLatin1Char(c);
+        } else {
+            res += QStringLiteral("\\x%1").arg(c, 2, 16, QLatin1Char('0'));
+        }
+    }
+    return res;
+}
+
+// Whether a unit is one of the app's: app[-<launcher>]-<id>[@<random>].service
+// or app[-<launcher>]-<id>-<random>.scope.
+bool unitBelongsTo(const QString &unit, const QString &appId)
+{
+    if (!unit.startsWith(QLatin1String("app-"))) {
+        return false;
+    }
+    QString rest = unit.mid(4);
+    if (rest.endsWith(QLatin1String(".service"))) {
+        rest.chop(8);
+        if (const int at = rest.indexOf(QLatin1Char('@')); at >= 0) {
+            rest.truncate(at);
+        }
+    } else if (rest.endsWith(QLatin1String(".scope"))) {
+        rest.chop(6);
+        const int dash = rest.lastIndexOf(QLatin1Char('-'));
+        if (dash < 0) {
+            return false;
+        }
+        rest.truncate(dash);
+    } else {
+        return false;
+    }
+    for (const QString &id : {escapeUnitName(appId), appId}) {
+        if (rest == id || rest.endsWith(QLatin1Char('-') + id)) {
+            return true;
+        }
+    }
+    return false;
+}
+
+// The cgroup path of a process, split: its units are among the parts.
+QStringList cgroupOf(quint32 pid)
+{
+    QFile file(QStringLiteral("/proc/%1/cgroup").arg(pid));
+    if (pid == 0 || !file.open(QIODevice::ReadOnly)) {
+        return {};
+    }
+    const auto lines = QString::fromUtf8(file.readAll()).split(QLatin1Char('\n'));
+    for (const QString &line : lines) {
+        if (line.startsWith(QLatin1String("0::"))) { // cgroup v2
+            return line.mid(3).split(QLatin1Char('/'), Qt::SkipEmptyParts);
+        }
+    }
+    return {};
+}
+
+bool isAlive(const QString &activeState)
+{
+    return activeState != QLatin1String("inactive") && activeState != QLatin1String("failed");
+}
+}
