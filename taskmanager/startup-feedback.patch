+class StartupNotifications : public QObject
+{
+    Q_OBJECT
+public:
+    using QObject::QObject;
+public Q_SLOTS:
+    void onActionInvoked(uint id, const QString &action)
+    {
+        Q_EMIT actionInvoked(id, action);
+    }
+    void onClosed(uint id, uint reason)
+    {
+        Q_UNUSED(reason)
+        Q_EMIT closed(id);
+    }
+    void onTrayItemRegistered(const QString &service)
+    {
+        Q_EMIT trayItemRegistered(service);
+    }
+Q_SIGNALS:
+    void actionInvoked(uint id, const QString &action);
+    void closed(uint id);
+    void trayItemRegistered(const QString &service);
+};
