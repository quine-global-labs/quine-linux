+void WaylandStartupTasksModel::Private::pollUnits(PlasmaActivation *activation)
+{
+    auto message = QDBusMessage::createMethodCall(s_systemd, s_systemdPath, s_systemdManager, QStringLiteral("ListUnitsByPatterns"));
+    message << QStringList{} << QStringList{QStringLiteral("app-*")};
+    // Parented to the activation: gone, and not answered, once it ends.
+    auto *watcher = new QDBusPendingCallWatcher(QDBusConnection::sessionBus().asyncCall(message), activation);
+    QObject::connect(watcher, &QDBusPendingCallWatcher::finished, q, [this, activation](QDBusPendingCallWatcher *watcher) {
+        watcher->deleteLater();
+        const QDBusMessage reply = watcher->reply();
+        auto *startup = find(activation);
+        if (!startup || reply.type() != QDBusMessage::ReplyMessage || reply.arguments().isEmpty()) {
+            return;
+        }
+        QHash<QString, QDBusObjectPath> alive;
+        const auto arg = reply.arguments().constFirst().value<QDBusArgument>();
+        arg.beginArray();
+        while (!arg.atEnd()) {
+            UnitInfo unit;
+            arg >> unit;
+            if (isAlive(unit.activeState) && unitBelongsTo(unit.name, startup->applicationId)) {
+                alive.insert(unit.name, unit.path);
+            }
+        }
+        arg.endArray();
+        unitsPolled(activation, alive);
+    });
+}
+
+void WaylandStartupTasksModel::Private::unitsPolled(PlasmaActivation *activation, const QHash<QString, QDBusObjectPath> &alive)
+{
+    auto *startup = find(activation);
+    if (!startup) {
+        return;
+    }
+
+    // When each unit started, asked once per unit.
+    for (auto it = alive.cbegin(); it != alive.cend(); ++it) {
+        if (startup->unitStarts.contains(it.key())) {
+            continue;
+        }
+        startup->unitStarts.insert(it.key(), -1);
+        auto message = QDBusMessage::createMethodCall(s_systemd, it.value().path(), QStringLiteral("org.freedesktop.DBus.Properties"), QStringLiteral("Get"));
+        message << QStringLiteral("org.freedesktop.systemd1.Unit") << QStringLiteral("InactiveExitTimestampMonotonic");
+        auto *watcher = new QDBusPendingCallWatcher(QDBusConnection::sessionBus().asyncCall(message), activation);
+        QObject::connect(watcher, &QDBusPendingCallWatcher::finished, q, [this, activation, unit = it.key()](QDBusPendingCallWatcher *watcher) {
+            watcher->deleteLater();
+            const QDBusPendingReply<QDBusVariant> reply = *watcher;
+            if (auto *startup = find(activation)) {
+                // Unknown counts as already running: never mistaken for the launch.
+                startup->unitStarts.insert(unit, reply.isValid() ? qint64(reply.value().variant().toULongLong()) : 0);
+            }
+        });
+    }
+
+    QStringList launched;
+    bool anotherRunning = false;
+    bool asking = false;
+    for (auto it = alive.cbegin(); it != alive.cend(); ++it) {
+        const qint64 started = startup->unitStarts.value(it.key(), -1);
+        if (started < 0) {
+            asking = true;
+        } else if (started >= startup->launchedUsec - s_startSlackUsec) {
+            launched << it.key();
+        } else {
+            anotherRunning = true;
+        }
+    }
+    if (!launched.isEmpty()) {
+        startup->units = launched;
+        if (!startup->sawUnit) {
+            qCDebug(TASKMANAGER_DEBUG) << "Startup" << startup->applicationId << "follows" << launched;
+            startup->sawUnit = true;
+            startup->stillStartingTimer->start(stillStartingTimeout);
+        }
+        return;
+    }
+    if (startup->sawUnit && !asking) {
+        // The launch's units ended, and no window of the app appeared.
+        qCDebug(TASKMANAGER_DEBUG) << "Startup" << startup->applicationId << "ended without a window; KWin finished:" << startup->kwinFinished;
+        if (!startup->kwinFinished && !startup->stopping) {
+            notifyDidNotOpen(*startup, anotherRunning);
+        }
         removeActivation(activation);
+    }
+}
+
+void WaylandStartupTasksModel::Private::endIfOwns(const QStringList &cgroup)
+{
+    if (cgroup.isEmpty()) {
+        return;
+    }
+    std::vector<PlasmaActivation *> ended;
+    for (const auto &startup : startups) {
+        if (std::ranges::any_of(startup.units, [&cgroup](const QString &unit) {
+                return cgroup.contains(unit);
+            })) {
+            ended.push_back(startup.activation.get());
+        }
+    }
+    for (auto *activation : ended) {
+        qCDebug(TASKMANAGER_DEBUG) << "Startup" << find(activation)->applicationId << "has a window or tray icon in its units";
+        removeActivation(activation);
+    }
+}
+
+void WaylandStartupTasksModel::Private::trayItemRegistered(const QString &service)
+{
+    if (startups.empty()) {
+        return;
+    }
+    // "org.kde.StatusNotifierItem-<pid>-<n>" or ":1.23", maybe with "/<path>".
+    const QString busName = service.section(QLatin1Char('/'), 0, 0);
+    auto message = QDBusMessage::createMethodCall(QStringLiteral("org.freedesktop.DBus"),
+                                                  QStringLiteral("/org/freedesktop/DBus"),
+                                                  QStringLiteral("org.freedesktop.DBus"),
+                                                  QStringLiteral("GetConnectionUnixProcessID"));
+    message << busName;
+    auto *watcher = new QDBusPendingCallWatcher(QDBusConnection::sessionBus().asyncCall(message), q);
+    QObject::connect(watcher, &QDBusPendingCallWatcher::finished, q, [this](QDBusPendingCallWatcher *watcher) {
+        watcher->deleteLater();
+        const QDBusPendingReply<uint> reply = *watcher;
+        if (reply.isValid()) {
+            // Started in the background, in the tray: done.
+            endIfOwns(cgroupOf(reply.value()));
+        }
+    });
+}
