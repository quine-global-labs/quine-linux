# What quine-linux turns on for every user. A preset only takes effect when
# something runs `systemctl --global preset`, which nothing does for files
# laid into the image, so the Containerfile also enables these with
# `systemctl --global enable`. Kept in sync, so a preset run agrees.
enable disk-cleanup.timer
# Both agents: ssh-agent for SSH keys (Plasma points SSH_AUTH_SOCK at it,
# /etc/xdg/plasma-workspace/env/ssh-agent.sh), gpg-agent for GnuPG only.
enable ssh-agent.socket
enable gpg-agent.socket
disable gpg-agent-ssh.socket
